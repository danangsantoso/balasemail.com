# Copy to .env and adjust. All services read the same variables.
# production enables JSON logs and strict secrets
APP_ENV=development
# Treat sender-domain DNS checks as passing so a local stack can send to Mailpit (ignored in production)
DEV_SKIP_DNS_CHECK=true
HTTP_ADDR=:8080
# Comma-separated emails promoted to platform super admin on login
SUPERADMIN_EMAILS=
# base for unsubscribe & tracking links
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://balasemail:balasemail@localhost:5432/balasemail?sslmode=disable

# Secrets (min. 16 chars; required in production)
JWT_SECRET=
SIGNING_SECRET=
ENCRYPTION_KEY=

# Sender authentication published to customers
SPF_INCLUDE=_spf.balasemail.com
DKIM_SELECTOR=bm1

# SMTP gateway
SMTP_HOSTNAME=mx.balasemail.local
# 587 in production
SMTP_SUBMISSION_ADDR=:2587
# 25 in production
SMTP_INBOUND_ADDR=:2525
SMS_DOMAIN=sms.balasemail.local
# VERP return-path domain; publish an MX record pointing at smtpd so DSN/FBL reports come back
BOUNCE_DOMAIN=bounces.balasemail.local
SMTP_TLS_CERT=
SMTP_TLS_KEY=

# Upstream relay (empty host = log only). Fallback is used on failure.
UPSTREAM_SMTP_HOST=
UPSTREAM_SMTP_PORT=587
UPSTREAM_SMTP_USERNAME=
UPSTREAM_SMTP_PASSWORD=
FALLBACK_SMTP_HOST=
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_USERNAME=
FALLBACK_SMTP_PASSWORD=

# SMS gateways in failover order: twilio,zenziva,log
SMS_PROVIDERS=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ZENZIVA_USERKEY=
ZENZIVA_PASSKEY=

# Email validation: SMTP probing needs outbound port 25
VALIDATOR_SMTP_PROBE=false
VALIDATOR_HELO=verify.balasemail.com
VALIDATOR_MAIL_FROM=verify@balasemail.com

# Finder crawler identity
FINDER_USER_AGENT=BalasEmailBot/1.0 (+https://balasemail.com/bot)
FINDER_MAX_PAGES=12

WORKER_CONCURRENCY=8

# Allow webhooks/crawler to reach private IPs (defaults to true only in development)
OUTBOUND_ALLOW_PRIVATE=
